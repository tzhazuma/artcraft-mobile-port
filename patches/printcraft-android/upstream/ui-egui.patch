diff --git a/crates/ui-egui/Cargo.toml b/crates/ui-egui/Cargo.toml
index ad3dc7b..eb2fc53 100644
--- a/crates/ui-egui/Cargo.toml
+++ b/crates/ui-egui/Cargo.toml
@@ -19,18 +19,23 @@ serde = { workspace = true }
 serde_json = { workspace = true }
 log = { workspace = true }
 
-rfd = { workspace = true }
 png = "0.18"
 base64 = "0.22"
 
 [target.'cfg(not(target_arch = "wasm32"))'.dependencies]
 # Control-channel tokens.
 getrandom = "0.4"
-# Create ▸ Clipboard (images; already in the tree through egui-winit).
-arboard = { version = "3.6", default-features = false, features = ["image-data"] }
 # Waits for native file pickers off the UI thread (already in the tree through wgpu).
 pollster = "1.0"
 
+# The native file dialogs and the system clipboard. Neither has an Android backend — `rfd` does
+# not even compile for it (its platform traits go unimplemented) — so Android leaves both out and
+# uses `src/fd.rs`'s host seam (installed by `apps/printcraft-android`) instead; the clipboard
+# falls back to the app's own snapshot.
+[target.'cfg(all(not(target_arch = "wasm32"), not(target_os = "android")))'.dependencies]
+rfd = { workspace = true }
+arboard = { version = "3.6", default-features = false, features = ["image-data"] }
+
 [target.'cfg(windows)'.dependencies]
 # Auto interface language: the Windows display language, without starting a process.
 sys-locale = "0.3"
