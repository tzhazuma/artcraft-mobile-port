+# The native file dialogs and the system clipboard. Neither has an Android backend -- `rfd` does
+# not even compile for it (its platform traits go unimplemented) -- so Android leaves both out and
+# uses `src/fd.rs`'s host seam (installed by `apps/printcraft-android`) instead; the clipboard
+# falls back to the app's own snapshot.
+[target.'cfg(all(not(target_arch = "wasm32"), not(target_os = "android")))'.dependencies]
+rfd = { workspace = true }
+arboard = { version = "3.6", default-features = false, features = ["image-data"] }
+
 [target.'cfg(all(unix, not(target_os = "macos"), not(target_arch = "wasm32")))'.dependencies]
 # Discover configured font directories without linking libfontconfig or running a subprocess.
 fontconfig-parser = "0.5.8"
